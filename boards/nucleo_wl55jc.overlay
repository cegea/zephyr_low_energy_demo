#include <zephyr/dt-bindings/adc/adc.h>

/ {
	zephyr,user {
		/* Arduino A0 = PB1 = ADC1_IN5 en esta placa. */
		io-channels = <&adc1 5>;
	};
};

&adc1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@5 {
		reg = <5>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

/*
 * Los estados STOP0/1/2 se usan tal como los declara stm32wl.dtsi
 * (suspend-to-idle, substate-id 1/2/3, min-residency-us 100/500/900, sin
 * exit-latency-us). El modo respuesta bloquea STOP1 y STOP2 por substate en
 * main.c, asi que no hace falta inventar latencias de salida aqui.
 */
